# Serveur
PORT=3000

# Base de données PostgreSQL (voir docker-compose.yml)
DATABASE_URL=postgresql://examhub:examhub_pwd@localhost:5432/examhub

# Authentification
JWT_SECRET=change_moi_en_production
JWT_EXPIRES_IN=8h

# Compte administrateur initial (utilisé par db/seed.ts)
ADMIN_EMAIL=admin@examhub.local
ADMIN_PASSWORD=Admin123!
